{
  "schemaVersion": "mps-create-input-policy-v1",
  "entities": {
    "IBY_PAYMENT_SYSTEM": {
      "fields": {
        "Name": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-ADE-003",
            "SRC-MPS-ADE-004",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory system label, independently unique; identity remains Suffix."
        },
        "StartDate": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-ADE-003",
            "SRC-MPS-ADE-004",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory root date; supply an explicit date. Do not infer execution date or rely on blank CSV preserving a constructor expression."
        },
        "EndDate": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-ADE-003",
            "SRC-MPS-ADE-004",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory root date; explicit 4712-12-31 represents no end. EO constructor default exists but is not permission to serialize an explicit null."
        }
      }
    },
    "ORA_IBY_PAYMENT_SYSTEM_ACC_NAME": {
      "fields": {
        "AccountOptionDatatype": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-005",
            "SRC-MPS-META-006",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory insert-only datatype; EO default VARCHAR2 is not silently selected or serialized as blank by this task."
        },
        "DisplayOrder": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-005",
            "SRC-MPS-META-006",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory numeric display order; supply explicitly. UI 1 is not an import default."
        },
        "AccountOptionName": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-005",
            "SRC-MPS-META-006",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory definition label."
        },
        "SecuredFlag": {
          "requiredOnCreate": true,
          "nonblankOnWrite": false,
          "sourceIds": [
            "SRC-MPS-META-005",
            "SRC-MPS-META-006",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Materialize the previously approved N default for a new definition only; explicit input is never overridden. This is metadata, not credential handling.",
          "default": {
            "value": "N",
            "sourceIds": [
              "SRC-MPS-META-006"
            ]
          }
        }
      }
    },
    "ORA_IBY_PAYMENT_SYSTEM_FORMAT": {
      "fields": {
        "StartDate": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-008",
            "SRC-MPS-META-009",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory format date; explicitly supplied, with StartDate < EndDate."
        },
        "EndDate": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-008",
            "SRC-MPS-META-009",
            "SRC-MPS-FW-CSV"
          ],
          "reason": "Mandatory format date; constructor default is not an implicit FSCR blank value."
        }
      }
    },
    "ORA_IBY_PAYMENT_SYSTEM_KEY": {
      "fields": {
        "Ownertype": {
          "requiredOnCreate": true,
          "nonblankOnWrite": false,
          "sourceIds": [
            "SRC-MPS-META-011",
            "SRC-MPS-META-012",
            "SRC-MPS-META-013"
          ],
          "reason": "Explicit account-creation input under the approved defaulting guidance; not a claim that the database column is NOT NULL. UI PAYEE default is not an import default."
        }
      }
    },
    "ORA_IBY_PAYMENT_SYSTEM_SCHEME": {
      "fields": {}
    },
    "ORA_IBY_PAYMENT_SYSTEM_TRAN": {
      "fields": {}
    },
    "ORA_IBY_PAYMENT_SYSTEM_ACC_VAL": {
      "fields": {
        "AccountOptionValue": {
          "requiredOnCreate": false,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-020",
            "SRC-MPS-META-021",
            "SRC-MPS-ADE-001"
          ],
          "reason": "Nonblank service value when explicitly written. Sensitive/unknown rows are removed before this policy."
        },
        "BuName": {
          "requiredOnCreate": false,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-020",
            "SRC-MPS-META-021",
            "SRC-MPS-ADE-001"
          ],
          "reason": "Nonblank when explicitly authored; BU_NAME import maps this name to the stored value."
        }
      },
      "byOptionCode": {
        "BU_NAME": {
          "required": [
            "BuName"
          ],
          "sourceIds": [
            "SRC-MPS-META-020",
            "SRC-MPS-META-021",
            "SRC-MPS-ADE-001"
          ],
          "reason": "Import hook resolves BuName to AccountOptionValue; do not request or invent the numeric ID."
        },
        "*": {
          "required": [
            "AccountOptionValue"
          ],
          "sourceIds": [
            "SRC-MPS-META-020",
            "SRC-MPS-META-021",
            "SRC-MPS-ADE-001"
          ],
          "reason": "Other reviewed ordinary option codes require an explicit canonical value and their existing bound resolution evidence."
        }
      }
    },
    "ORA_IBY_PAYMENT_SYSTEM_ACC_NAME_TRANSLATION": {
      "fields": {
        "SourceLang": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-023",
            "SRC-MPS-META-024"
          ],
          "reason": "Mandatory translation source language; require explicit verified language, never infer a locale."
        },
        "AccountOptionName": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-MPS-META-023",
            "SRC-MPS-META-024"
          ],
          "reason": "Mandatory translation label; Language remains an immutable key."
        },
        "ORA_IBY_PAYMENT_SYSTEM_ACC_NAME.AccountOptionCode": {
          "requiredOnCreate": true,
          "nonblankOnWrite": true,
          "sourceIds": [
            "SRC-FSM-PACKAGE",
            "SRC-MPS-ADE-001",
            "SRC-MPS-META-023"
          ],
          "reason": "Portable owning-definition context column must be explicitly supplied and equal AccountOptionCode; it is not a database ID."
        }
      }
    }
  },
  "keyFields": "Required by the existing portable business-key contract.",
  "systemManagedExclusions": "Audit columns, physical IDs and ObjectVersionNumber are not business inputs. Joined bank mandatory attributes do not establish unconditional root requiredness.",
  "defaultsBoundary": "Only the previously approved SecuredFlag=N default is materialized. No date, owner, display-order, language, lookup or credential value is invented.",
  "sensitiveBoundary": "Existing sensitive/unknown value omission and root credential guards remain authoritative.",
