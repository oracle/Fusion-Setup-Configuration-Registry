<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:z="urn:iso:std:iso:20022:tech:xsd:pain.002.001.03" version="1.0">
  <xsl:output method="xml" />
  <xsl:template match="/">
     <xsl:variable name="hdrMsgId">
        <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:OrgnlMsgId" />
     </xsl:variable>
     <AckResponse>
        <PmtHeader>
           <MsgId>
              <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:OrgnlMsgId" />
           </MsgId>
           <xsl:variable name="MsgStsCode">
              <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:GrpSts" />
           </xsl:variable>
           <MsgSts>
              <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:GrpSts" />
           </MsgSts>
           <MsgStsCd>
              <xsl:choose>
                 <xsl:when test=" $MsgStsCode='ACSP' or
			                   $MsgStsCode='ACSC' or
							   $MsgStsCode='ACCP' or
							   $MsgStsCode='ACTC' or
							   $MsgStsCode='ACWC' or
							   $MsgStsCode='RCVD' or
							   $MsgStsCode='PDNG' or
							   $MsgStsCode='PART'
							   ">ACKNOWLEDGED</xsl:when>
                 <xsl:when test="$MsgStsCode='RJCT'">REJECTED</xsl:when>
                 <xsl:otherwise>ACKNOWLEDGED</xsl:otherwise>
              </xsl:choose>
           </MsgStsCd>
           <MsgErrCd>
              <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:StsRsnInf/z:Rsn/z:Cd" />
           </MsgErrCd>
           <MsgErrDet>
              <xsl:value-of select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlGrpInfAndSts/z:StsRsnInf/z:AddtlInf" />
           </MsgErrDet>
        </PmtHeader>
        <xsl:for-each select="/z:Document/z:CstmrPmtStsRpt/z:OrgnlPmtInfAndSts/z:TxInfAndSts">
           <PmtDetls>
              <PmtRef>
                 <xsl:value-of select="z:OrgnlEndToEndId" />
              </PmtRef>
              <xsl:variable name="dtlsPmtSts">
                 <xsl:value-of select="z:TxSts" />
              </xsl:variable>
              <xsl:variable name="PmtStsCode">
                 <xsl:choose>
                    <xsl:when test="$hdrMsgId='UNAVAILABLE' and $dtlsPmtSts=''">
                       <xsl:value-of select="../z:NbOfTxsPerSts/z:DtldSts" />
                    </xsl:when>
                    <xsl:otherwise>
                       <xsl:value-of select="z:TxSts" />
                    </xsl:otherwise>
                 </xsl:choose>
              </xsl:variable>
              <PmtSts>
                 <xsl:value-of select="$PmtStsCode" />
              </PmtSts>
              <PmtStsCd>
                 <xsl:choose>
                    <xsl:when test=" $PmtStsCode='ACSP' or
				                  $PmtStsCode='ACSC' or
								  $PmtStsCode='ACCP' or
								  $PmtStsCode='ACTC' or
								  $PmtStsCode='ACWC' or
								  $PmtStsCode='RCVD' or
								  $PmtStsCode='PDNG'">ACKNOWLEDGED</xsl:when>
                    <xsl:when test="$PmtStsCode='RJCT'">REJECTED</xsl:when>
                    <xsl:otherwise>ACKNOWLEDGED</xsl:otherwise>
                 </xsl:choose>
              </PmtStsCd>
              <xsl:variable name="prtry">
                       <xsl:for-each select="z:StsRsnInf/z:Rsn/z:Prtry">
                           <xsl:value-of select="concat(.,' ')" />
                       </xsl:for-each>
                   </xsl:variable>
              <PmtMsgErrCd>
                <xsl:choose>
                           <xsl:when test="string-length($prtry) &lt;= 30">
                               <xsl:value-of select="substring($prtry,1,string-length($prtry)-1)" />
                           </xsl:when>
                           <xsl:otherwise>
                               <xsl:value-of select="substring($prtry,1,30)" />
                           </xsl:otherwise>
                 </xsl:choose>
              </PmtMsgErrCd>
              <xsl:variable name="addtlInf">
                       <xsl:for-each select="z:StsRsnInf/z:AddtlInf">
                           <xsl:value-of select="concat(.,' ')" />
                       </xsl:for-each>
                   </xsl:variable>
              <PmtMsgErrDet>
                <xsl:choose>
                           <xsl:when test="string-length($addtlInf) &lt;= 255">
                               <xsl:value-of select="substring($addtlInf,1,string-length($addtlInf)-1)" />
                           </xsl:when>
                           <xsl:otherwise>
                               <xsl:value-of select="substring($addtlInf,1,255)" />
                           </xsl:otherwise>
                       </xsl:choose>
              </PmtMsgErrDet>
              <xsl:variable name="ClrSysRef">
                 <xsl:value-of select="z:ClrSysRef" />
              </xsl:variable>
             <PmtClearingNum>
                 <xsl:value-of select="substring($ClrSysRef, 1, 35)" />
              </PmtClearingNum>
		   <xsl:variable name="PmtRjctRsnCd">
				<xsl:value-of select="z:StsRsnInf/z:Rsn/z:Prtry" />
              </xsl:variable>
      <xsl:if test=" $PmtRjctRsnCd='060109' or $PmtRjctRsnCd='060203' or $PmtRjctRsnCd='060112' or $PmtRjctRsnCd='060224' or $PmtRjctRsnCd='060412' or $PmtRjctRsnCd='060419' ">
		<InvHoldCd>ORA_AP_BANK_ACK_RJCT</InvHoldCd>
        </xsl:if>
           </PmtDetls>
        </xsl:for-each>
     </AckResponse>
  </xsl:template>
</xsl:stylesheet>
